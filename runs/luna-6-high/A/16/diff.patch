+    def add_usage_event(self, subscription_id: str, event: UsageEvent) -> bool:
+        events = self._usage_events.setdefault(subscription_id, {})
+        if event.event_id in events:
+            return False
+        events[event.event_id] = event
+        return True
+
+    def has_usage_event(self, subscription_id: str, event_id: str) -> bool:
+        return event_id in self._usage_events.get(subscription_id, {})
+
