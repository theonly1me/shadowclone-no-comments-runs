@@ -27,6 +39,41 @@ class InMemoryStore:
     def get_subscription(self, subscription_id: str) -> Subscription:
         return self._subscriptions[subscription_id]
 
+    def record_usage_event(
+        self, subscription_id: str, event: UsageEvent
+    ) -> bool:
+        event_ids = self._usage_event_ids.setdefault(subscription_id, set())
+        if event.event_id in event_ids:
+            return False
+        event_ids.add(event.event_id)
+        self._usage_events.setdefault(subscription_id, []).append(event)
+        return True
+
+    def has_usage_event(self, subscription_id: str, event_id: str) -> bool:
+        return event_id in self._usage_event_ids.get(subscription_id, set())
+
+    def get_unbilled_usage_events(self, subscription_id: str) -> list[UsageEvent]:
+        billed_ids = self._billed_usage_event_ids.setdefault(subscription_id, set())
+        return [
+            event
+            for event in self._usage_events.get(subscription_id, [])
+            if event.event_id not in billed_ids
+        ]
+
+    def mark_usage_events_billed(
+        self, subscription_id: str, event_ids: set[str]
+    ) -> None:
+        self._billed_usage_event_ids.setdefault(subscription_id, set()).update(event_ids)
+
+    def get_plan_changes(self, subscription_id: str) -> list[PlanChange]:
+        return self._plan_changes.get(subscription_id, [])
+
+    def add_plan_change(self, subscription_id: str, change: PlanChange) -> None:
+        self._plan_changes.setdefault(subscription_id, []).append(change)
+
+    def clear_plan_changes(self, subscription_id: str) -> None:
+        self._plan_changes[subscription_id] = []
+
     def add_discount_code(self, code: DiscountCode) -> None:
