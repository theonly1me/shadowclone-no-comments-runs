@@ -27,6 +29,27 @@ class InMemoryStore:
     def get_subscription(self, subscription_id: str) -> Subscription:
         return self._subscriptions[subscription_id]
 
+    def record_usage(self, subscription_id: str, event: UsageEvent) -> bool:
+        self.get_subscription(subscription_id)
+        event_ids = self._usage_event_ids.setdefault(subscription_id, set())
+        if event.event_id in event_ids:
+            return False
+        event_ids.add(event.event_id)
+        self._usage_events.setdefault(subscription_id, []).append(event)
+        return True
+
+    def get_usage_events(self, subscription_id: str) -> list[UsageEvent]:
+        self.get_subscription(subscription_id)
+        return list(self._usage_events.get(subscription_id, []))
+
+    def remove_usage_events(self, subscription_id: str, events: list[UsageEvent]) -> None:
+        event_ids = {event.event_id for event in events}
+        self._usage_events[subscription_id] = [
+            event
+            for event in self._usage_events.get(subscription_id, [])
+            if event.event_id not in event_ids
+        ]
+
