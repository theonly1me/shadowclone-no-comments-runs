+@dataclass
+class Segment:
+    """A run of days `[start, end)` in the period billed on one plan."""
+
+    plan: Plan
+    start: date
+    end: date
+    units: int = 0
+
+    @property
+    def days(self) -> int:
+        return (self.end - self.start).days
+
+
+def build_segments(
+    subscription: Subscription, plans: dict[str, Plan], events: list[UsageEvent]
+) -> list[Segment]:
+    segments = []
+    start, plan_id = subscription.period_start, subscription.plan_id
+    for effective_on, new_plan_id in subscription.plan_changes:
+        segments.append(Segment(plans[plan_id], start, effective_on))
+        start, plan_id = effective_on, new_plan_id
+    segments.append(Segment(plans[plan_id], start, subscription.period_end))
+
+    for event in events:
+        # Late events for a closed period fall into the first segment.
+        target = segments[0]
+        for segment in segments:
+            if segment.start <= event.occurred_on < segment.end:
+                target = segment
+                break
+        target.units += event.units
+    return segments
+
