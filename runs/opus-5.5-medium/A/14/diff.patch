+
+    @staticmethod
+    def _segment_index(segments: list[Segment], occurred_on: date) -> int:
+        # Late events from a closed period land in the first segment.
+        for index in range(len(segments) - 1, 0, -1):
+            if occurred_on >= segments[index].start:
+                return index
+        return 0
