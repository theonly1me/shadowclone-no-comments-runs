+    def record_usage(
+        self, subscription_id: str, event_id: str, units: int, occurred_on: date
+    ) -> bool:
+        subscription = self._store.get_subscription(subscription_id)
+        # Duplicate calls are ignored entirely, including invalid replacement units.
+        if event_id in subscription.usage_events:
+            return False
+        if units <= 0:
+            raise ValueError("Usage units must be greater than zero")
+        subscription.usage_events[event_id] = UsageEvent(event_id, units, occurred_on)
+        return True
+
+    def change_plan(
+        self, subscription_id: str, new_plan_id: str, effective_on: date
+    ) -> None:
+        subscription = self._store.get_subscription(subscription_id)
+        self._store.get_plan(new_plan_id)
+        if not subscription.period_start < effective_on < subscription.period_end:
+            raise ValueError("Plan changes must be strictly within the open period")
+        if subscription.plan_changes and effective_on <= subscription.plan_changes[-1].effective_on:
+            raise ValueError("Plan changes must be in strictly increasing date order")
+        if new_plan_id == subscription.plan_id:
+            raise ValueError("The subscription is already on this plan")
+
+        subscription.plan_changes.append(
+            PlanChange(subscription.plan_id, new_plan_id, effective_on)
+        )
+        subscription.plan_id = new_plan_id
+
