+            raise ValueError("Plan change must be strictly within the open period")
+        if (
+            subscription.plan_changes
+            and effective_on <= subscription.plan_changes[-1].effective_on
+        ):
+            raise ValueError("Plan changes must be in strictly increasing date order")
+        if new_plan_id == subscription.plan_id:
+            raise ValueError("The requested plan is already current")
+
+        subscription.plan_changes.append(
