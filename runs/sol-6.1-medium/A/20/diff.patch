+        if not previous_date < effective_on < subscription.period_end:
+            raise ValueError("Plan changes must be strictly ordered within the open period")
+        if new_plan_id == current_plan_id:
+            raise ValueError("The requested plan is already current")
+        changes.append(PlanChange(new_plan_id, effective_on))
