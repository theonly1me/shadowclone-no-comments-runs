+    def add_usage_event(self, event: UsageEvent) -> bool:
+        """Store the event; return False if its event_id was already recorded."""
+        events = self._usage_events.setdefault(event.subscription_id, {})
+        if event.event_id in events:
+            return False
+        events[event.event_id] = event
+        return True
+
+    def get_unbilled_usage_events(self, subscription_id: str) -> list[UsageEvent]:
+        events = self._usage_events.get(subscription_id, {})
