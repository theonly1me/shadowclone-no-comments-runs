+    def add_usage_event(self, subscription_id: str, event: UsageEvent) -> bool:
+        """Store the event unless its id is already recorded for the subscription."""
+        events = self._usage.setdefault(subscription_id, {})
+        if event.event_id in events:
+            return False
+        events[event.event_id] = event
