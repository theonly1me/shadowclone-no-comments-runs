diff --git a/tests/test_usage.py b/tests/test_usage.py
new file mode 100644
index 0000000..5bee710
--- /dev/null
+++ b/tests/test_usage.py
@@ -0,0 +1,211 @@
+from datetime import date
+
+import pytest
+
+from ledger.models import Plan
+
+
+@pytest.fixture(autouse=True)
+def plans(store):
+    store.add_plan(
+        Plan("basic", "Basic", 3000, included_units=30, overage_unit_price_cents=10)
+    )
+    store.add_plan(
+        Plan("pro", "Pro", 6000, included_units=60, overage_unit_price_cents=5)
+    )
+    store.add_plan(Plan("max", "Max", 9000))
+
+
+def lines(invoice):
+    return [(i.kind, i.description, i.amount_cents) for i in invoice.line_items]
+
+
+def test_record_usage_validation(billing):
+    with pytest.raises(ValueError):
+        billing.record_usage("s1", "e1", 0, date(2026, 1, 2))
+    with pytest.raises(ValueError):
+        billing.record_usage("s1", "e1", -3, date(2026, 1, 2))
+    with pytest.raises(KeyError):
+        billing.record_usage("nope", "e1", 1, date(2026, 1, 2))
+
+
+def test_usage_is_idempotent_per_event_id(billing):
+    assert billing.record_usage("s1", "e1", 40, date(2026, 1, 2)) is True
+    assert billing.record_usage("s1", "e1", 999, date(2026, 5, 5)) is False
+
+    invoice = billing.generate_invoice("s1")
+
+    assert lines(invoice)[1] == ("overage", "Overage: Basic", 100)
+
+
+def test_usage_within_included_has_no_overage(billing):
+    billing.record_usage("s1", "e1", 30, date(2026, 1, 30))
+
+    assert [i.kind for i in billing.generate_invoice("s1").line_items] == ["plan"]
+
+
+def test_event_at_period_end_is_not_billed_yet_and_billed_once(billing):
+    billing.record_usage("s1", "e1", 50, date(2026, 1, 31))
+    billing.record_usage("s1", "e2", 31, date(2026, 1, 10))
+
+    first = billing.generate_invoice("s1")
+    second = billing.generate_invoice("s1")
+
+    assert lines(first)[1] == ("overage", "Overage: Basic", 10)
+    assert lines(second)[1] == ("overage", "Overage: Basic", 200)
+    third = billing.generate_invoice("s1")
+    assert [i.kind for i in third.line_items] == ["plan"]
+
+
+def test_event_id_stays_recorded_after_billing(billing):
+    billing.record_usage("s1", "e1", 50, date(2026, 1, 10))
+    billing.generate_invoice("s1")
+
+    assert billing.record_usage("s1", "e1", 50, date(2026, 2, 10)) is False
+    assert [i.kind for i in billing.generate_invoice("s1").line_items] == ["plan"]
+
+
+def test_late_event_is_billed_on_open_period(billing):
+    billing.generate_invoice("s1")
+    billing.record_usage("s1", "late", 40, date(2026, 1, 5))
+
+    invoice = billing.generate_invoice("s1")
+
+    assert lines(invoice)[1] == ("overage", "Overage: Basic", 100)
+
+
+def test_same_event_id_in_different_subscriptions(billing, store):
+    from ledger.models import Subscription
+
+    store.add_subscription(
+        Subscription("s2", "c1", "basic", date(2026, 1, 1), date(2026, 1, 31))
+    )
+    assert billing.record_usage("s1", "e1", 1, date(2026, 1, 2)) is True
+    assert billing.record_usage("s2", "e1", 1, date(2026, 1, 2)) is True
+
+
+def test_plan_change_prorates_segments(billing, store):
+    billing.change_plan("s1", "pro", date(2026, 1, 11))
+
+    invoice = billing.generate_invoice("s1")
+
+    assert lines(invoice) == [
+        ("plan", "Plan: Basic", 1000),
+        ("plan", "Plan: Pro", 4000),
+    ]
+    assert invoice.total_cents == 5000
+    subscription = store.get_subscription("s1")
+    assert subscription.plan_id == "pro"
+    assert subscription.plan_changes == []
+
+
+def test_plan_change_rounds_half_up(billing, store):
+    store.add_plan(Plan("tiny", "Tiny", 5))
+    store.add_plan(Plan("tiny2", "Tiny2", 5))
+    billing.change_plan("s1", "tiny", date(2026, 1, 2))  # basic 1 day -> 100
+    billing.change_plan("s1", "tiny2", date(2026, 1, 5))  # tiny 3 days: 0.5 -> 1
+    # tiny2 26 days: 4.333 -> 4
+
+    invoice = billing.generate_invoice("s1")
+
+    assert [i.amount_cents for i in invoice.line_items] == [100, 1, 4]
+
+
+def test_multiple_changes_with_usage_and_proration(billing, store):
+    billing.change_plan("s1", "pro", date(2026, 1, 11))  # basic 10d, pro 20d
+    # basic: included 30*10//30 = 10 ; pro: included 60*20//30 = 40
+    billing.record_usage("s1", "a", 15, date(2026, 1, 10))  # basic -> 5 over
+    billing.record_usage("s1", "b", 50, date(2026, 1, 11))  # pro -> 10 over
+    billing.record_usage("s1", "c", 4, date(2026, 1, 30))  # pro -> 14 over
+    billing.record_usage("s1", "late", 1, date(2025, 12, 1))  # basic -> 6 over
+
+    invoice = billing.generate_invoice("s1")
+
+    assert lines(invoice) == [
+        ("plan", "Plan: Basic", 1000),
+        ("plan", "Plan: Pro", 4000),
+        ("overage", "Overage: Basic", 60),
+        ("overage", "Overage: Pro", 70),
+    ]
+    assert invoice.total_cents == 5130
+
+
+def test_included_units_floor_division(billing):
+    billing.change_plan("s1", "pro", date(2026, 1, 2))  # basic 1d: 30*1//30 = 1
+    billing.record_usage("s1", "a", 2, date(2026, 1, 1))
+
+    invoice = billing.generate_invoice("s1")
+
+    assert ("overage", "Overage: Basic", 10) in lines(invoice)
+
+
+def test_discount_credit_tax_apply_to_plan_and_overage(billing, store):
+    from decimal import Decimal
+
+    from ledger.models import DiscountCode
+
+    store.add_discount_code(DiscountCode("TEN", percent_off=Decimal("10")))
+    customer = store.get_customer("c1")
+    customer.tax_rate_percent = Decimal("10")
+    customer.credit_balance_cents = 500
+    billing.record_usage("s1", "a", 40, date(2026, 1, 3))
+
+    invoice = billing.generate_invoice("s1", discount_code="TEN")
+
+    assert [(i.kind, i.amount_cents) for i in invoice.line_items] == [
+        ("plan", 3000),
+        ("overage", 100),
+        ("discount", -310),
+        ("credit", -500),
+        ("tax", 229),
+    ]
+    assert invoice.total_cents == 2519
+    assert customer.credit_balance_cents == 0
+
+
+def test_change_plan_validation_leaves_state_unchanged(billing, store):
+    subscription = store.get_subscription("s1")
+    for plan_id, day in [
+        ("pro", date(2026, 1, 1)),  # == period_start
+        ("pro", date(2026, 1, 31)),  # == period_end
+        ("pro", date(2026, 2, 5)),
+        ("basic", date(2026, 1, 5)),  # already current
+    ]:
+        with pytest.raises(ValueError):
+            billing.change_plan("s1", plan_id, day)
+    with pytest.raises(KeyError):
+        billing.change_plan("s1", "ghost", date(2026, 1, 5))
+    with pytest.raises(KeyError):
+        billing.change_plan("ghost", "pro", date(2026, 1, 5))
+    assert subscription.plan_changes == []
+
+    billing.change_plan("s1", "pro", date(2026, 1, 10))
+    for plan_id, day in [
+        ("max", date(2026, 1, 10)),  # not after previous change
+        ("max", date(2026, 1, 9)),
+        ("pro", date(2026, 1, 20)),  # already current
+    ]:
+        with pytest.raises(ValueError):
+            billing.change_plan("s1", plan_id, day)
+    assert len(subscription.plan_changes) == 1
+
+
+def test_change_back_to_original_plan_is_allowed(billing):
+    billing.change_plan("s1", "pro", date(2026, 1, 11))
+    billing.change_plan("s1", "basic", date(2026, 1, 21))
+
+    invoice = billing.generate_invoice("s1")
+
+    assert [i.amount_cents for i in invoice.line_items] == [1000, 2000, 1000]
+
+
+def test_changes_are_cleared_for_next_period(billing, store):
+    billing.change_plan("s1", "pro", date(2026, 1, 11))
+    billing.generate_invoice("s1")
+
+    next_invoice = billing.generate_invoice("s1")
+
+    assert [i.description for i in next_invoice.line_items] == ["Plan: Pro"]
+    # Next period starts 2026-01-31, so the earlier boundary applies again.
+    with pytest.raises(ValueError):
+        billing.change_plan("s1", "basic", date(2026, 1, 31))
