+            ),
+        )
+        for segment in segments
+    ]
+
+    segment_units = [0] * len(segments)
+    starts = [segment.start for segment in segments]
+    for event in usage_events:
+        index = max(bisect_right(starts, event.occurred_on) - 1, 0)
