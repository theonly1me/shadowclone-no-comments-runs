+@dataclass(frozen=True)
+class Segment:
+    start: date
+    end: date
+    plan: Plan
+
+    @property
+    def days(self) -> int:
+        return (self.end - self.start).days
+
+
+def build_segments(subscription: Subscription, plans: dict[str, Plan]) -> list[Segment]:
+    starts = [subscription.period_start]
+    plan_ids = [subscription.plan_id]
+    for change in subscription.plan_changes:
+        starts.append(change.effective_on)
+        plan_ids.append(change.plan_id)
+    ends = starts[1:] + [subscription.period_end]
+    return [
+        Segment(start, end, plans[plan_id])
+        for start, end, plan_id in zip(starts, ends, plan_ids)
+    ]
+
