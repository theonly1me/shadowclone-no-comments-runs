         return self._invoices[invoice_id]
+
+    def add_usage_event(self, event: UsageEvent) -> bool:
+        key = (event.subscription_id, event.event_id)
+        if key in self._usage_events:
+            return False
+        self._usage_events[key] = event
+        return True
+
+    def get_unbilled_usage(self, subscription_id: str) -> list[UsageEvent]:
+        return [
+            event
+            for event in self._usage_events.values()
+            if event.subscription_id == subscription_id and not event.billed
+        ]
