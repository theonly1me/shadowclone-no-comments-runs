+    assert lines(invoice) == [
+        ("plan", "Plan: Basic", 1000),
+        ("plan", "Plan: Pro", 4000),
+        ("overage", "Overage: Pro", 70),
+        ("discount", "Discount", -507),
+        ("credit", "Account credit", -500),
+        ("tax", "Tax", 406),
